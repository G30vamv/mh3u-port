# build output and scratch analysis (extracted game data lives under target/live and target/host)
target/

# personal save-file copies used by some tests; never publish
snapshots/

# anything extracted from the game or copied from reference projects
*.rpx
*.arc
*.gmd
rpx_data.bin

# local editor/tool state
.claude/
*.log

# core dumps QEMU writes when a guest test program crashes (qemu_mh3u-ppc-*.core)
*.core

# game dumps and anything from them: never commit (the port's output folder belongs outside the repository anyway)
*.rpl
*.wud
*.wux
*.app
*.h3
*.tmd
*.tik
*.cert
title.key*
keys.txt
game.h
f_*.c
game.dll
libgame.so
# saves and per-hunter mod state
save/
user[1-3]
wishlist.json
wishlist.json.migrated
wishlists/
mh3u_latest.log

# the game's icon and any other image from a dump
*.tga
